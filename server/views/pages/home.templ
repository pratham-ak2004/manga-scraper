package pages

import (
"download-server/views/layout"
"download-server/cmd/utils"
"download-server/db/generated"
"download-server/views/components"
"download-server/views/components/svg"
"fmt"
)

templ Home(data utils.DashBoardData, taskDetails generated.DashboardTaskDetailsRow) {
@layout.DashBoard("Dashboard"){
<!-- Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-8">
  <!-- Total Manga Card -->
  <div class="bg-card rounded-xl border border-border shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-muted-foreground text-sm font-medium">Total Manga</p>
        <p class="text-3xl font-bold text-primary mt-2">{ fmt.Sprintf("%d", data.Total.Manga) }</p>
      </div>
      <div class="bg-primary/10 p-3 rounded-lg group-hover:bg-primary/15 transition-colors">
        @svg.Book()
      </div>
    </div>
  </div>

  <!-- Total Chapters Card -->
  <div class="bg-card rounded-xl border border-border shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-muted-foreground text-sm font-medium">Total Chapters</p>
        <p class="text-3xl font-bold text-success mt-2">{ fmt.Sprintf("%d", data.Total.Chapter) }</p>
      </div>
      <div class="bg-success/10 p-3 rounded-lg group-hover:bg-success/15 transition-colors">
        @svg.TextFile()
      </div>
    </div>
  </div>

  <!-- Total Pages Card -->
  <div class="bg-card rounded-xl border border-border shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-muted-foreground text-sm font-medium">Total Pages</p>
        <p class="text-3xl font-bold text-warning mt-2">{ fmt.Sprintf("%d", data.Total.Pages) }</p>
      </div>
      <div class="bg-warning/10 p-3 rounded-lg group-hover:bg-warning/15 transition-colors">
       @svg.EmptyFile()
      </div>
    </div>
  </div>
</div>

<!-- Status Overview -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-8">

  <div class="bg-card rounded-xl border border-primary/20 shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-foreground">Ongoing</h3>
      <span class="bg-primary/20 text-primary text-sm font-semibold px-2.5 py-1 rounded-lg">
        { fmt.Sprintf("%d", data.Status.Ongoing) }
      </span>
    </div>
    <div class="w-full bg-primary/10 rounded-full h-3 overflow-hidden">
      <div class="bg-gradient-to-r from-primary to-primary/70 h-3 rounded-full transition-all duration-500 ease-out"
        style={ fmt.Sprintf("width: %d%%", calculatePercentage(data.Status.Ongoing, data.Total.Manga)) }></div>
    </div>
    <p class="text-xs text-muted-foreground mt-2">{ fmt.Sprintf("%d%%", calculatePercentage(data.Status.Ongoing,
      data.Total.Manga)) } of total manga</p>
  </div>

  <div class="bg-card rounded-xl border border-success/20 shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-foreground">Completed</h3>
      <span class="bg-success/20 text-success text-sm font-semibold px-2.5 py-1 rounded-lg">
        { fmt.Sprintf("%d", data.Status.Completed) }
      </span>
    </div>
    <div class="w-full bg-success/10 rounded-full h-3 overflow-hidden">
      <div class="bg-gradient-to-r from-success to-success/70 h-3 rounded-full transition-all duration-500 ease-out"
        style={ fmt.Sprintf("width: %d%%", calculatePercentage(data.Status.Completed, data.Total.Manga)) }></div>
    </div>
    <p class="text-xs text-muted-foreground mt-2">{ fmt.Sprintf("%d%%", calculatePercentage(data.Status.Completed,
      data.Total.Manga)) } of total manga</p>
  </div>

  <div class="bg-card rounded-xl border border-warning/20 shadow-sm p-6 hover:shadow-md transition-all group">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-foreground">Upcoming</h3>
      <span class="bg-warning/20 text-warning text-sm font-semibold px-2.5 py-1 rounded-lg">
        { fmt.Sprintf("%d", data.Status.Upcoming) }
      </span>
    </div>
    <div class="w-full bg-warning/10 rounded-full h-3 overflow-hidden">
      <div class="bg-gradient-to-r from-warning to-warning/70 h-3 rounded-full transition-all duration-500 ease-out"
        style={ fmt.Sprintf("width: %d%%", calculatePercentage(data.Status.Upcoming, data.Total.Manga)) }></div>
    </div>
    <p class="text-xs text-muted-foreground mt-2">{ fmt.Sprintf("%d%%", calculatePercentage(data.Status.Upcoming,
      data.Total.Manga)) } of total manga</p>
  </div>
</div>

<!-- Task Overview -->
<div>
  <div class="mb-6 sm:mb-8">
    <div class="mb-2">
      <h3 class="text-xl font-semibold text-foreground">Task Status</h3>
      <p class="text-sm text-muted-foreground">Background task execution overview</p>
    </div>
     <div class="flex items-center gap-2 mb-2 justify-between">
     <div>
        <label for="timeDropdown" class="text-sm text-muted-foreground">Refresh every:</label>
        <select id="timeDropdown" class="border rounded px-2 py-1 text-sm">
          <option value="0">None</option>
          <option value="1">1s</option>
          <option value="5">5s</option>
          <option value="10" selected>10s</option>
          <option value="30">30s</option>
          <option value="60">1m</option>
        </select>
      </div>
      <a href="/dashboard/tasks" class="flex flex-row justify-center items-center gap-2 text-muted-foreground">
      tasks 
      @svg.ExternalLink()
      </a>
    </div>
    <div id="polling-element" hx-get="/task/status" hx-trigger="every 10s, refresh" hx-swap="innerHTML">
      @components.TaskDetails(taskDetails)
    </div>
    <script>
      document.getElementById('timeDropdown').addEventListener('change', function() {
        // Get the new interval value from the dropdown
        var newInterval = this.value;

        // Update the hx-trigger attribute of the target element
        var pollingElement = document.getElementById('polling-element');
        if (newInterval === '0') {
          pollingElement.setAttribute('hx-trigger', 'none');
        } else {
          pollingElement.setAttribute('hx-trigger', 'every ' + newInterval + 's, refresh');
        }

        // Force htmx to re-process the element and its new attributes
        htmx.process(pollingElement);

        // Trigger an immediate refresh
        htmx.trigger(pollingElement, 'refresh');
      });
    </script>
  </div>
</div>

<!-- Recent Manga List -->
<div class="bg-card rounded-xl border border-border shadow-sm overflow-hidden">
  <div class="p-6 border-b border-border">
    <h3 class="text-xl font-semibold text-foreground">Recent Manga</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-muted/50 border-b border-border">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Poster</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Chapters
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Pages</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Last
            Updated</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        for _, manga := range data.Manga {
        <tr class="hover:bg-muted/50 transition-colors">
          <td class="px-6 py-4">
            <div class="flex-shrink-0 h-24 w-16">
              if manga.Poster.Valid && manga.Poster.String != "" {
              <a href={ manga.Poster.String } target="_blank" rel="noreferrer">
                <img class="h-24 w-16 object-cover rounded-lg shadow-sm border border-border" src={ manga.Poster.String
                  } alt="Manga poster" />
              </a>
              } else {
              <div class="h-24 w-16 bg-muted rounded-lg flex items-center justify-center border border-border">
                <svg class="w-8 h-8 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              }
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm font-medium text-foreground">
              <a href={ templ.SafeURL("/dashboard/manga/" + manga.MangaID) }
                class="hover:text-primary transition-colors hover:underline">
                if manga.Title.Valid {
                { manga.Title.String }
                } else {
                <span class="text-muted-foreground">Untitled</span>
                }
              </a>
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-foreground">{ fmt.Sprintf("%d", manga.TotalChapters) }</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-foreground">{ fmt.Sprintf("%d", manga.TotalPages) }</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            if manga.Status.Valid {
            if manga.Status.Status == "COMPLETED" {
            <span
              class="px-2.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-success/10 text-success border border-success/20">
              Completed
            </span>
            } else if manga.Status.Status == "ONGOING" {
            <span
              class="px-2.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-primary/10 text-primary border border-primary/20">
              Ongoing
            </span>
            } else {
            <span
              class="px-2.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-warning/10 text-warning border border-warning/20">
              Upcoming
            </span>
            }
            } else {
            <span
              class="px-2.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-muted text-muted-foreground border border-border">
              Unknown
            </span>
            }
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
            if manga.MangaUpdatedAt.Valid {
            { manga.MangaUpdatedAt.Time.Format("Jan 02, 2006") }
            } else {
            <span class="text-muted-foreground/50">-</span>
            }
          </td>
        </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}
}

func calculatePercentage(value int32, total int32) int {
if total == 0 {
return 0
}
return int((float64(value) / float64(total)) * 100)
}
