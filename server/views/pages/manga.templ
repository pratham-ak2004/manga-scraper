package pages

import (
"download-server/db/generated"
"download-server/views/layout"
"download-server/views/components/ui"
"fmt"
)

templ Manga(data []generated.Manga) {
@layout.DashBoard("Manga List") {
<!-- Search and Filter Bar -->
<!-- div class="mb-6 flex flex-col md:flex-row gap-4">
  <div class="flex-1">
    <input type="text" placeholder="Search manga..."
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
  </div>
  <select class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
    <option value="">All Status</option>
    <option value="COMPLETED">Completed</option>
    <option value="ONGOING">Ongoing</option>
    <option value="UPCOMING">Upcoming</option>
  </select>
</div -->

<!-- New Manga submission -->
<div class="mb-6 bg-white rounded-lg shadow p-6">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Add New Manga</h3>
  <form hx-post="/api/v1/manga" hx-target="#manga-result" hx-swap="innerHTML" class="flex gap-3">
    <input type="text" required name="manga-url" placeholder="Enter Manga URL"
      class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
    @ui.Button(ui.ButtonProps{
    Type: "submit",
    Variant: ui.ButtonDefault,
    Size: ui.ButtonSizeLg,
    }){
    Add Manga
    }
  </form>
  <div id="manga-result" class="mt-4"></div>
</div>

<!-- Stats Summary -->
<div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-gray-500 text-sm">Total Manga</p>
    <p class="text-2xl font-bold text-gray-800">{ fmt.Sprintf("%d", len(data)) }</p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-gray-500 text-sm">Completed</p>
    <p class="text-2xl font-bold text-green-600">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusCOMPLETED)) }
    </p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-gray-500 text-sm">Ongoing</p>
    <p class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusONGOING)) }</p>
  </div>
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-gray-500 text-sm">Upcoming</p>
    <p class="text-2xl font-bold text-yellow-600">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusUPCOMING)) }
    </p>
  </div>
</div>

<!-- Manga Grid -->
if len(data) == 0 {
<div class="bg-white rounded-lg shadow p-12 text-center">
  <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
  </svg>
  <h3 class="mt-2 text-xl font-medium text-gray-900">No manga found</h3>
  <p class="mt-1 text-gray-500">Get started by adding your first manga.</p>
</div>
} else {
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  for _, manga := range data {
  <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
    <!-- Poster Image -->
    <div class="relative h-80 bg-gray-200">
      if manga.Poster.Valid && manga.Poster.String != "" {
      <img src={ manga.Poster.String } alt={ manga.Title.String } class="w-full h-full object-cover" />
      } else {
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-20 h-20 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      }

      <!-- Status Badge -->
      <div class="absolute top-2 right-2">
        if manga.Status.Valid {
        if manga.Status.Status == generated.StatusCOMPLETED {
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-500 text-white">
          Completed
        </span>
        } else if manga.Status.Status == generated.StatusONGOING {
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-500 text-white">
          Ongoing
        </span>
        } else {
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-500 text-white">
          Upcoming
        </span>
        }
        }
      </div>
    </div>

    <!-- Card Content -->
    <div class="p-4">
      <h3 class="font-bold text-lg text-gray-900 mb-2 line-clamp-2 min-h-[3.5rem]">
        if manga.Title.Valid {
        { manga.Title.String }
        } else {
        <span class="text-gray-400">Untitled</span>
        }
      </h3>

      if manga.Description.Valid && manga.Description.String != "" {
      <p class="text-gray-600 text-sm mb-3 line-clamp-3">
        { manga.Description.String }
      </p>
      }

      <!-- Metadata -->
      <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
        <span>
          if manga.Createdat.Valid {
          Added { manga.Createdat.Time.Format("Jan 2006") }
          }
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-2">
        <a href={ templ.SafeURL("/dashboard/manga/" + manga.ID) } class="w-full">
          @ui.Button(ui.ButtonProps{
          Variant: ui.ButtonDefault,
          Size: ui.ButtonSizeDefault,
          Class: "w-full",
          }){
          More Details
          }
        </a>
        <a href={ templ.SafeURL(manga.Url) } target="_blank" class="w-full">
          @ui.Button(ui.ButtonProps{
          Variant: ui.ButtonOutline,
          Size: ui.ButtonSizeDefault,
          Class: "w-full",
          }){
          View Source
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-external-link-icon lucide-external-link">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
          }
        </a>
      </div>
    </div>
  </div>
  }
</div>
}
}
}

func countByStatus(data []generated.Manga, status generated.Status) int {
count := 0
for _, manga := range data {
if manga.Status.Valid && manga.Status.Status == status {
count++
}
}
return count
}
