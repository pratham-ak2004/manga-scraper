package pages

import (
"download-server/db/generated"
"download-server/views/layout"
"download-server/views/components/ui"
"download-server/views/components/svg"
"fmt"
)

templ Manga(data []generated.Manga) {
@layout.DashBoard("Manga List") {

<!-- New Manga submission -->
<div class="mb-6 bg-card rounded-xl border border-border shadow-sm p-6">
  <h3 class="text-lg font-semibold text-foreground mb-4">Add New Manga</h3>
  <form hx-post="/api/v1/manga" hx-target="#manga-result" hx-swap="innerHTML" class="flex flex-col sm:flex-row gap-3">
    <input type="text" required name="manga-url" placeholder="Enter Manga URL"
      class="flex-1 px-4 py-2.5 bg-background border border-input rounded-lg focus:ring-2 focus:ring-ring focus:border-transparent text-foreground placeholder:text-muted-foreground transition-all" />
    @ui.Button(ui.ButtonProps{
    Type: "submit",
    Variant: ui.ButtonDefault,
    Size: ui.ButtonSizeLg,
    }){
    Add Manga
    }
  </form>
  <div id="manga-result" class="mt-4 hidden"></div>
</div>

<!-- Stats Summary -->
<div class="mb-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
  <div class="bg-card rounded-xl border border-border shadow-sm p-4 hover:shadow-md transition-shadow">
    <p class="text-muted-foreground text-sm font-medium">Total Manga</p>
    <p class="text-2xl font-bold text-foreground mt-1">{ fmt.Sprintf("%d", len(data)) }</p>
  </div>
  <div class="bg-card rounded-xl border border-border shadow-sm p-4 hover:shadow-md transition-shadow">
    <p class="text-muted-foreground text-sm font-medium">Completed</p>
    <p class="text-2xl font-bold text-success mt-1">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusCOMPLETED))
      }
    </p>
  </div>
  <div class="bg-card rounded-xl border border-border shadow-sm p-4 hover:shadow-md transition-shadow">
    <p class="text-muted-foreground text-sm font-medium">Ongoing</p>
    <p class="text-2xl font-bold text-primary mt-1">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusONGOING)) }
    </p>
  </div>
  <div class="bg-card rounded-xl border border-border shadow-sm p-4 hover:shadow-md transition-shadow">
    <p class="text-muted-foreground text-sm font-medium">Upcoming</p>
    <p class="text-2xl font-bold text-warning mt-1">{ fmt.Sprintf("%d", countByStatus(data, generated.StatusUPCOMING)) }
    </p>
  </div>
</div>

<!-- Manga Grid -->
if len(data) == 0 {
<div class="bg-card rounded-xl border border-border shadow-sm p-12 text-center">
  <svg class="mx-auto h-12 w-12 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
  </svg>
  <h3 class="mt-2 text-xl font-medium text-foreground">No manga found</h3>
  <p class="mt-1 text-muted-foreground">Get started by adding your first manga.</p>
</div>
} else {
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
  for _, manga := range data {
  <div
    class="bg-card rounded-xl border border-border shadow-sm overflow-hidden hover:shadow-lg hover:border-primary/50 transition-all duration-300 group">
    <!-- Poster Image -->
    <div class="relative h-80 bg-muted">
      if manga.Poster.Valid && manga.Poster.String != "" {
      <img src={ manga.Poster.String } alt={ manga.Title.String }
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
      } else {
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-20 h-20 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      }

      <!-- Status Badge -->
      <div class="absolute top-3 right-3">
        if manga.Status.Valid {
        if manga.Status.Status == generated.StatusCOMPLETED {
        <span
          class="px-2.5 py-1 text-xs font-semibold rounded-full bg-success/90 text-success-foreground shadow-lg backdrop-blur-sm border border-success/20">
          Completed
        </span>
        } else if manga.Status.Status == generated.StatusONGOING {
        <span
          class="px-2.5 py-1 text-xs font-semibold rounded-full bg-primary/90 text-primary-foreground shadow-lg backdrop-blur-sm border border-primary/20">
          Ongoing
        </span>
        } else {
        <span
          class="px-2.5 py-1 text-xs font-semibold rounded-full bg-warning/90 text-warning-foreground shadow-lg backdrop-blur-sm border border-warning/20">
          Upcoming
        </span>
        }
        }
      </div>
    </div>

    <!-- Card Content -->
    <div class="p-4">
      <h3 class="font-bold text-lg text-foreground mb-2 line-clamp-2 min-h-[3.5rem]">
        if manga.Title.Valid {
        { manga.Title.String }
        } else {
        <span class="text-muted-foreground">Untitled</span>
        }
      </h3>

      if manga.Description.Valid && manga.Description.String != "" {
      <p class="text-muted-foreground text-sm mb-3 line-clamp-3">
        { manga.Description.String }
      </p>
      }

      <!-- Metadata -->
      <div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
        <span>
          if manga.Createdat.Valid {
          Added { manga.Createdat.Time.Format("Jan 2006") }
          }
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-2">
        <a href={ templ.SafeURL("/dashboard/manga/" + manga.ID) } class="flex-1">
          @ui.Button(ui.ButtonProps{
          Variant: ui.ButtonDefault,
          Size: ui.ButtonSizeDefault,
          Class: "w-full",
          }){
          View Details
          }
        </a>
        <a href={ templ.SafeURL(manga.Url) } target="_blank" rel="noreferrer">
          @ui.Button(ui.ButtonProps{
          Variant: ui.ButtonOutline,
          Size: ui.ButtonSizeIcon,
          }){
          @svg.ExternalLink()
          }
        </a>
      </div>
    </div>
  </div>
  }
</div>
}
}
}

func countByStatus(data []generated.Manga, status generated.Status) int {
count := 0
for _, manga := range data {
if manga.Status.Valid && manga.Status.Status == status {
count++
}
}
return count
}
