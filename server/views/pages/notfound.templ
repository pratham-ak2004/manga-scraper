package pages

import (
"download-server/views/layout"
)
templ NotFound() {
@layout.DashBoard("Not Found", true){
<div class="flex flex-col items-center justify-center py-24">
  <h1 class="text-3xl font-bold text-gray-800 mb-4">404 - Page Not Found</h1>
  <p class="text-gray-600 text-lg">The requested page is not available.</p>
</div>
}
}
