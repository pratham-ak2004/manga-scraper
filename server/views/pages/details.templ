package pages

import (
"fmt"
"download-server/db/generated"
"download-server/views/layout"
"download-server/views/components/ui"
)

templ Details(manga generated.Manga, details generated.ListMangaDetailsRow) {
@layout.DashBoard(manga.Title.String) {
<!-- Back Button -->
<div class="mb-6">
  <a href="/dashboard/manga" class="inline-flex items-center text-gray-600 hover:text-gray-900">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Back to Manga List
  </a>
</div>

<!-- Manga Details Card -->
<div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
  <div class="md:flex">
    <!-- Poster Section -->
    <div class="md:w-1/3 lg:w-1/4">
      <div class="relative h-96 md:h-full bg-gray-200">
        if manga.Poster.Valid && manga.Poster.String != "" {
        <img src={ manga.Poster.String } alt={ manga.Title.String } class="w-full h-full object-cover" />
        } else {
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-20 h-20 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        }
        <!-- Status Badge -->
        <div class="absolute top-4 right-4">
          if manga.Status.Valid {
          if manga.Status.Status == generated.StatusCOMPLETED {
          <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-500 text-white">Completed</span>
          } else if manga.Status.Status == generated.StatusONGOING {
          <span class="px-3 py-1 text-sm font-semibold rounded-full bg-blue-500 text-white">Ongoing</span>
          } else {
          <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-500 text-white">Upcoming</span>
          }
          }
        </div>
      </div>
    </div>

    <!-- Info Section -->
    <div class="md:w-2/3 lg:w-3/4 p-6">
      <!-- Title -->
      <h1 class="text-3xl font-bold text-gray-900 mb-4">
        if manga.Title.Valid {
        { manga.Title.String }
        } else {
        <span class="text-gray-400">Untitled</span>
        }
      </h1>

      <!-- Description -->
      if manga.Description.Valid && manga.Description.String != "" {
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Description</h2>
        <p class="text-gray-600 leading-relaxed">{ manga.Description.String }</p>
      </div>
      }


      <!-- Stats Summary -->
      <div class="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-lg shadow p-4">
          <p class="text-gray-500 text-sm">Total Chapters</p>
          <p class="text-2xl font-bold text-gray-800">{ fmt.Sprintf("%d", details.ChapterCount) }</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <p class="text-gray-500 text-sm">Total Pages</p>
          <p class="text-2xl font-bold text-green-600">{ fmt.Sprintf("%d", details.PageCount) }
          </p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <p class="text-gray-500 text-sm">Average Pages</p>
          <p class="text-2xl font-bold text-blue-600">{ fmt.Sprintf("%d", details.AvgPagesPerChapter)}</p>
        </div>
      </div>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        if manga.Details != nil {
        if details, ok := manga.Details.(map[string]interface{}); ok {
        <!-- Author(s) -->
        if authors, ok := details["Author(s)"].([]interface{}); ok && len(authors) > 0 {
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Author(s)</h3>
          <div class="flex flex-wrap gap-2">
            for _, author := range authors {
            if authorMap, ok := author.(map[string]interface{}); ok {
            if name, ok := authorMap["name"].(string); ok {
            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">{ name }</span>
            }
            }
            }
          </div>
        </div>
        }

        <!-- Type -->
        if types, ok := details["Type"].([]interface{}); ok && len(types) > 0 {
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Type</h3>
          for _, t := range types {
          if typeMap, ok := t.(map[string]interface{}); ok {
          if name, ok := typeMap["name"].(string); ok {
          <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm">{ name }</span>
          }
          }
          }
        </div>
        }

        <!-- Tags -->
        if tags, ok := details["Tags(s)"].([]interface{}); ok && len(tags) > 0 {
        <div class="md:col-span-2">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Tags</h3>
          <div class="flex flex-wrap gap-2">
            for _, tag := range tags {
            if tagMap, ok := tag.(map[string]interface{}); ok {
            if name, ok := tagMap["name"].(string); ok {
            <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm">{ name }</span>
            }
            }
            }
          </div>
        </div>
        }
        }
        }
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3">
        <a href={ templ.SafeURL(manga.Url) } target="_blank" class="flex-1">
          @ui.Button(ui.ButtonProps{
          Variant: ui.ButtonDefault,
          Size: ui.ButtonSizeLg,
          Class: "w-full",
          }) {
          View Source
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
          }
        </a>
      </div>

      <!-- Additional Info -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="grid grid-cols-2 gap-4 text-sm text-gray-600">
          if manga.Createdat.Valid {
          <div>
            <span class="font-semibold">Added:</span> { manga.Createdat.Time.Format("Jan 02, 2006") }
          </div>
          }
          if manga.Updatedat.Valid {
          <div>
            <span class="font-semibold">Updated:</span> { manga.Updatedat.Time.Format("Jan 02, 2006") }
          </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Archive Form -->
<div class="mb-6 bg-white rounded-lg shadow-lg p-6">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Create Archive</h3>
  <form hx-post={ "/api/v1/archive" } hx-target="#archive-result" hx-swap="innerHTML">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
      <!-- Start Chapter -->
      <input type="text" value={ manga.ID } hidden name="manga-id" id="manga-id" />
      <div>
        <label for="start" class="block text-sm font-medium text-gray-700 mb-1">Start Chapter</label>
        <input type="number" step="0.1" name="start" id="start" placeholder="0.0"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          required />
      </div>

      <!-- End Chapter -->
      <div>
        <label for="end" class="block text-sm font-medium text-gray-700 mb-1">End Chapter</label>
        <input type="number" step="0.1" name="end" id="end" placeholder="0.0"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          required />
      </div>

      <!-- Full Archive Checkbox -->
      <div class="flex items-end">
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" id="full-checkbox"
            class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
            onchange="document.getElementById('full-hidden').value = this.checked" />
          <input type="hidden" id="full-hidden" name="full" value="false" />
          <span class="text-sm font-medium text-gray-700">Full Archive</span>
        </label>
      </div>

      <!-- Submit Button -->
      <div class="flex items-end">
        @ui.Button(ui.ButtonProps{
        Type: "submit",
        Variant: ui.ButtonDefault,
        Size: ui.ButtonSizeLg,
        Class: "w-full",
        }) {
        Create Archive
        }
      </div>
    </div>

    <!-- Result Container -->
    <div id="archive-result" class="mt-4"></div>
  </form>
</div>

<!-- Tabs Section -->
<div class="bg-white rounded-lg shadow-lg overflow-hidden">
  <!-- Tab Headers -->
  <div class="border-b border-gray-200">
    <nav class="flex -mb-px">
      <button class="tab-button px-6 py-4 text-sm font-medium border-b-2 border-blue-500 text-blue-600"
        hx-get={ "/manga/chapters/" + manga.ID } hx-target="#tab-content" hx-trigger="click, load"
        onclick="setActiveTab(this)">
        Chapters
      </button>
      <button
        class="tab-button px-6 py-4 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
        hx-get={ "/manga/archives/" + manga.ID } hx-target="#tab-content" hx-trigger="click"
        onclick="setActiveTab(this)">
        Archives
      </button>
    </nav>
  </div>

  <!-- Tab Content -->
  <div id="tab-content" class="p-6">
    <!-- Content will be loaded here via HTMX -->
    <div class="flex items-center justify-center py-12">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
    </div>
  </div>
</div>

<!-- Tab Switching Script -->
<script>
  function setActiveTab(button) {
    // Remove active styles from all buttons
    document.querySelectorAll('.tab-button').forEach(btn => {
      btn.classList.remove('border-blue-500', 'text-blue-600');
      btn.classList.add('border-transparent', 'text-gray-500');
    });

    // Add active styles to clicked button
    button.classList.remove('border-transparent', 'text-gray-500');
    button.classList.add('border-blue-500', 'text-blue-600');

    window.location.hash = "tab-content";
    // Optionally, smooth scroll into view
    var el = document.getElementById("tab-content");
    if (el) {
      el.scrollIntoView({behavior: "smooth"});
    }
  }
</script>
}
}
