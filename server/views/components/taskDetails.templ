package components

import (
"download-server/db/generated"
"fmt"
)

templ TaskDetails(taskDetails generated.DashboardTaskDetailsRow) {
<div class="w-full h-1 mb-2 bg-transparent rounded-full overflow-hidden relative">
  <div
    class="absolute inset-0 w-1/4 bg-gradient-to-r from-transparent via-primary to-transparent animate-slide-highlight">
  </div>
</div>
<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
  <!-- Success Tasks -->
  <div class="bg-card rounded-lg border border-success/20 shadow-sm p-3 hover:shadow-md transition-all">
    <div class="flex items-center justify-between mb-2">
      <svg class="w-4 h-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-xs font-medium text-success">Success</span>
    </div>
    <p class="text-xl font-bold text-success">{ fmt.Sprintf("%d", taskDetails.SuccessfulTasks) }</p>
  </div>

  <!-- Pending Tasks -->
  <div class="bg-card rounded-lg border border-border shadow-sm p-3 hover:shadow-md transition-all">
    <div class="flex items-center justify-between mb-2">
      <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-xs font-medium text-muted-foreground">Pending</span>
    </div>
    <p class="text-xl font-bold text-foreground">{ fmt.Sprintf("%d", taskDetails.PendingTasks) }</p>
  </div>

  <!-- Started Tasks -->
  <div class="bg-card rounded-lg border border-primary/20 shadow-sm p-3 hover:shadow-md transition-all">
    <div class="flex items-center justify-between mb-2">
      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
        </path>
      </svg>
      <span class="text-xs font-medium text-primary">Running</span>
    </div>
    <p class="text-xl font-bold text-primary">{ fmt.Sprintf("%d", taskDetails.StartedTasks) }</p>
  </div>

  <!-- Retry Tasks -->
  <div class="bg-card rounded-lg border border-warning/20 shadow-sm p-3 hover:shadow-md transition-all">
    <div class="flex items-center justify-between mb-2">
      <svg class="w-4 h-4 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
        </path>
      </svg>
      <span class="text-xs font-medium text-warning">Retry</span>
    </div>
    <p class="text-xl font-bold text-warning">{ fmt.Sprintf("%d", taskDetails.RetryTasks) }</p>
  </div>

  <!-- Failed Tasks -->
  <div class="bg-card rounded-lg border border-destructive/20 shadow-sm p-3 hover:shadow-md transition-all">
    <div class="flex items-center justify-between mb-2">
      <svg class="w-4 h-4 text-destructive" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-xs font-medium text-destructive">Failed</span>
    </div>
    <p class="text-xl font-bold text-destructive">{ fmt.Sprintf("%d", taskDetails.FailedTasks) }</p>
  </div>
</div>
}
