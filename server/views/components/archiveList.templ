package components

import (
    "download-server/db/generated"
    "fmt"
)

templ ArchivesList(archives []generated.Archive) {
    if len(archives) == 0 {
        <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
            </svg>
            <h3 class="mt-2 text-lg font-medium text-foreground">No archives found</h3>
            <p class="mt-1 text-muted-foreground">This manga doesn't have any archives yet.</p>
        </div>
    } else {
        <div class="overflow-x-auto rounded-xl border border-border">
            <table class="min-w-full divide-y divide-border">
                <thead class="bg-muted/50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Archive
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Range
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Status
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Size
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Created
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-card divide-y divide-border">
                    for _, archive := range archives {
                        <tr class="hover:bg-muted/50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-3">
                                    <div class="flex-shrink-0 h-10 w-10 flex items-center justify-center bg-accent rounded-lg">
                                        <svg class="h-5 w-5 text-accent-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-sm font-medium text-foreground">
                                            if archive.Complete.Valid && archive.Complete.Bool {
                                                Full Archive
                                            } else {
                                                { fmt.Sprintf("%.1f", archive.Startchapter.Float64) } - { fmt.Sprintf("%.1f", archive.Endchapter.Float64) }
                                            }
                                        </div>
                                        <div class="text-xs text-muted-foreground">
                                            ID: { archive.ID[:8] }...
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-foreground">
                                    if archive.Complete.Valid && archive.Complete.Bool {
                                        <span class="font-medium">All Chapters</span>
                                    } else {
                                        if archive.Startchapter.Valid && archive.Endchapter.Valid {
                                            Ch { fmt.Sprintf("%.1f", archive.Startchapter.Float64) } - { fmt.Sprintf("%.1f", archive.Endchapter.Float64) }
                                        } else {
                                            <span class="text-muted-foreground">N/A</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                if archive.Status.Valid {
                                    if archive.Status.ArchiveStatus == generated.ArchiveStatusCOMPLETED {
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-success/10 text-success border border-success/20">
                                            Completed
                                        </span>
                                    } else if archive.Status.ArchiveStatus == generated.ArchiveStatusPENDING {
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-warning/10 text-warning border border-warning/20">
                                            Pending
                                        </span>
                                    } else if archive.Status.ArchiveStatus == generated.ArchiveStatusFAILED {
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-destructive/10 text-destructive border border-destructive/20">
                                            Failed
                                        </span>
                                    }
                                } else {
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-muted text-muted-foreground border border-border">
                                        Unknown
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-foreground">
                                    if archive.Size.Valid && archive.Size.Int64 > 0 {
                                        { formatFileSize(archive.Size.Int64) }
                                    } else {
                                        <span class="text-muted-foreground">-</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-foreground">
                                    if archive.Createdat.Valid {
                                        { archive.Createdat.Time.Format("Jan 02, 2006") }
                                    } else {
                                        <span class="text-muted-foreground">N/A</span>
                                    }
                                </div>
                                <div class="text-xs text-muted-foreground">
                                    if archive.Createdat.Valid {
                                        { archive.Createdat.Time.Format("3:04 PM") }
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex items-center justify-end space-x-3">
                                    if archive.Status.Valid && archive.Status.ArchiveStatus == generated.ArchiveStatusCOMPLETED {
                                        <a href={ templ.SafeURL("/archives/download/" + archive.Filepath) }
                                            class="text-success hover:text-success/80 inline-flex items-center transition-colors"
                                            title="Download Archive">
                                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                            </svg>
                                        </a>
                                    }
                                    <button
                                        class="text-destructive hover:text-destructive/80 inline-flex items-center transition-colors"
                                        title="Delete Archive">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Summary Footer -->
        <div class="mt-4 px-6 py-3 bg-muted/30 border-t border-border rounded-b-xl">
            <p class="text-sm text-muted-foreground">
                Showing <span class="font-medium text-foreground">{ fmt.Sprintf("%d", len(archives)) }</span> archives
            </p>
        </div>
    }
}

func formatFileSize(bytes int64) string {
    const unit = 1024
    if bytes < unit {
        return fmt.Sprintf("%d B", bytes)
    }
    div, exp := int64(unit), 0
    for n := bytes / unit; n >= unit; n /= unit {
        div *= unit
        exp++
    }
    return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}